@model List<AvansFysio.Models.Appointments.AppointmentsViewModel>

<div class="content-list">
    @if (Model.Count == 0)
    {
        <p>Geen afspraken gevonden.</p>
    }
    @foreach (var appointment in @Model)
    {
        <partial name="_FutureAppointmentRow" model="appointment"/>
    }
</div>