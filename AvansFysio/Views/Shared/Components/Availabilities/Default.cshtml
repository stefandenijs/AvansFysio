@model List<AvansFysio.Models.Availability.AvailabilitiesViewModel>

<div>
    @if (@Model.Count == 0)
    {
        <p><strong>Geen beschikbaarheden gevonden. Stel ze in met de knop wijzig.</strong></p>
    }
    else
    {
        foreach (var availability in @Model)
        {
            <partial name="_Availability" model="availability" />
        }
    }
</div>