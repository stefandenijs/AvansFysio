@model List<AvansFysio.Models.Treatments.TreatmentsViewModel>

<div class="content-list">
    @if (@Model.Count == 0)
    {
        <p>Geen behandelingen gevonden.</p>
    }
    else
    {
        foreach (var treatment in Model)
        {
            <partial name="_SmallTreatmentRow" model="treatment"/>
        }
    }
</div>