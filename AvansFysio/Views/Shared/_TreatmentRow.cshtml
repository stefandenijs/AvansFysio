@model AvansFysio.Models.Treatments.TreatmentsViewModel

<div class="view-row">
    <div class="row no-gutters">
        <div class="col-sm-2">
            <p><strong>Code:</strong></p>
            <p>@Model.Code</p>
        </div>
        <div class="col-sm-10">
            <p><strong>Omschrijving:</strong></p>
            <p>@Model.Description</p>
        </div>
    </div>
    <div class="row no-gutters">
        <div class="col-sm-4">
            <p><strong>Behandelaar:</strong></p>
            <p>@Model.Practitioner</p>
        </div>
        <div class="col-sm-4">
            <p><strong>Ruimte:</strong></p>
            <p>@Model.Room</p>
        </div>
        <div class="col-sm-4">
            <p><strong>Uitgevoerd op:</strong></p>
            <p>@($"{Model.PerformedOn:dd-MM-yyy}")</p>
        </div>
    </div>
    <div class="mt-1">
        <a class="btn btn-primary" asp-action="TreatmentDetails" asp-controller="Treatment" asp-route-id="@Model.Id">Details</a>
        @if (User.HasClaim(c => c.Type == "Claim.Physiotherapist"))
        {
            <button class="btn btn-primary" id="DeleteTreatment" type="button" onclick="DeleteTreatmentPatient(this, '@Url.Action("DeleteTreatment", "Treatment")', @Model.Id)">Verwijder</button>
        }
    </div>
</div>