@model List<AvansFysio.Models.Appointments.AppointmentsViewModel>

@{
    ViewData["Title"] = "Mijn afspraken";
}

<div class="container-fluid">
    <div class="mb-3">
        @if (User.HasClaim(c => c.Type == "Claim.Physiotherapist"))
        {
            <a asp-action="AppointmentWorkerForm" asp-controller="Appointment" asp-route-id="@ViewBag.WorkerId" class="btn btn-primary">Maak afspraak</a>
        }
        else if (User.HasClaim(c => c.Type == "Claim.Patient"))
        {
            <a asp-action="AppointmentPatientForm" asp-controller="Appointment" asp-route-id="@ViewBag.PatientId" class="btn btn-primary">Maak afspraak</a>
        }
    </div>
    <input type="checkbox" name="OldAppointments" onchange="RemoveOldAppointments(this)"/>
    <label for="OldAppointments">Verberg afgelopen afspraken.</label>
    @if (@Model.Count == 0)
    {
        <div class="content-block">
            <h2>Geen afspraken gevonden</h2>
        </div>
    }
    else
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Datum</th>
                    <th>Tijd</th>
                    @if (User.HasClaim(c => c.Type == "Claim.Physiotherapist" || c.Type == "Claim.Intern"))
                    {
                        <th>Patiënt</th>
                    }
                    else
                    {
                        <th>Behandelaar</th>
                    }
                    <th>Behandeling</th>
                    <th>Opties</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in @Model)
                {
                    <partial name="_AppointmentRow" model="appointment" />
                }
            </tbody>
        </table>
    }
</div>