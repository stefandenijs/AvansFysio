@model AvansFysio.Models.Treatments.TreatmentsViewModel

@{
    ViewData["Title"] = "Behandeling details";
}

<div class="container-fluid d-flex justify-content-center">
    <div class="col-sm-6">
        <div class="mb-3">
            <a asp-action="Details" asp-controller="Patient" asp-route-id="@Model.PatientId">Terug naar patiëntendossier</a>
        </div>
        <div class="content-block">
            <div class="row">
                <h2>Gegevens</h2>
                @if (User.HasClaim(c => c.Type == "Claim.Physiotherapist"))
                {
                    <a class="btn btn-primary ml-auto" asp-action="UpdateTreatmentForm" asp-controller="Treatment" asp-route-id="@Model.PatientId" asp-route-treatmentId="@Model.Id">Wijzig behandeling</a>

                }
            </div>
            <div class="row no-gutters">
                <div class="col-sm-2">
                    <p><strong>Code:</strong></p>
                    <p>@Model.Code</p>
                </div>
                <div class="col-sm-10">
                    <p><strong>Omschrijving:</strong></p>
                    <p>@Model.Description</p>
                </div>
            </div>
            <div class="row no-gutters">
                <div class="col-sm-4">
                    <p><strong>Behandelaar:</strong></p>
                    <p>@Model.Practitioner</p>
                </div>
                <div class="col-sm-4">
                    <p><strong>Ruimte:</strong></p>
                    <p>@Model.Room</p>
                </div>
                <div class="col-sm-4">
                    <p><strong>Uitgevoerd op:</strong></p>
                    <p>@($"{Model.PerformedOn:dd-MM-yyy}")</p>
                </div>
            </div>
            <div>
                <p><strong>Bijzonderheden:</strong></p>
                <p>@Model.Particularities</p>
            </div>
        </div>
    </div>
</div>